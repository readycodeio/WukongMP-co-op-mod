<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Configurations>Debug;Release;NoDisconnect</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WukongMp.Coop.Common\WukongMp.Coop.Common.csproj"/>
    </ItemGroup>

    <!--
        Resource strings are generated into the assembly, every language inlined, so this mod ships
        no satellite assemblies. GenerateResource=false stops the .resx being compiled at all, and
        PreventMSB3030 stops MSBuild trying to copy satellites that were therefore never produced.
    -->
    <PropertyGroup>
        <ResXGenerator_GenerationType>CodeGeneration</ResXGenerator_GenerationType>
        <ResXGenerator_NullForgivingOperators>true</ResXGenerator_NullForgivingOperators>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aigamo.ResXGenerator" Version="4.4.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="@(EmbeddedResource)">
            <GenerateResource>false</GenerateResource>
        </EmbeddedResource>
    </ItemGroup>

    <Target Name="PreventMSB3030" DependsOnTargets="ComputeIntermediateSatelliteAssemblies" BeforeTargets="GenerateSatelliteAssemblies">
        <ItemGroup>
            <IntermediateSatelliteAssembliesWithTargetPath Remove="@(IntermediateSatelliteAssembliesWithTargetPath)"/>
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <UseSdkProjectReferences Condition="'$(UseSdkProjectReferences)' == ''">false</UseSdkProjectReferences>
        <!-- Where the SDK sources live when building in source mode. An uberrepo overrides
             these; the defaults assume the repositories sit side by side. -->
        <WukongSdkRoot Condition="'$(WukongSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\wukongmp-sdk</WukongSdkRoot>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\readym-core-sdk</CoreSdkRoot>
        <LoaderDllPath Condition="'$(LoaderDllPath)' == ''">$(WukongSdkRoot)\WukongMp.Api\Core</LoaderDllPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseSdkProjectReferences)' == 'true'">
        <ProjectReference Include="$(WukongSdkRoot)\WukongMp.Sdk\WukongMp.Sdk.csproj"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseSdkProjectReferences)' == 'false'">
        <PackageReference Include="ReadyM.SDK.Wukong.Client" Version="0.4.0" />
    </ItemGroup>

    <!-- Third-party game and core DLLs. Paths overridable via Directory.Build.props. -->

    <ItemGroup Label="Mod loader DLLs" Condition="'$(UseSdkProjectReferences)' == 'true'">
        <Reference Include="0Harmony">
            <HintPath>$(LoaderDllPath)\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBase">
            <HintPath>$(LoaderDllPath)\CSharpModBase.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBaseV2">
            <HintPath>$(LoaderDllPath)\CSharpModBaseV2.dll</HintPath>
        </Reference>
        <Reference Include="PreludeLib">
            <HintPath>$(LoaderDllPath)\PreludeLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8"/>
    </ItemGroup>


    <ItemGroup>
        <!-- Reference-only assemblies for the game. Compile-time only, the real
             assemblies are already loaded in the game process at runtime. -->
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831" />
    </ItemGroup>
</Project>