<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Configurations>Debug;Release;NoDisconnect</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WukongMp.Coop.Common\WukongMp.Coop.Common.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <UseSdkProjectReferences Condition="'$(UseSdkProjectReferences)' == ''">false</UseSdkProjectReferences>
        <!-- Where the SDK sources live when building in source mode. An uberrepo overrides
             these; the defaults assume the repositories sit side by side. -->
        <WukongSdkRoot Condition="'$(WukongSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\wukong-csharp-mod</WukongSdkRoot>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\readym-core-sdk</CoreSdkRoot>
        <SdkDllPath Condition="'$(SdkDllPath)' == ''">$(MSBuildThisFileDirectory)..\Dependencies\SDK</SdkDllPath>
        <LoaderDllPath Condition="'$(CoreDllPath)' == ''">$(MSBuildThisFileDirectory)..\Dependencies\Loader</LoaderDllPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseSdkProjectReferences)' == 'true'">
        <ProjectReference Include="$(WukongSdkRoot)\WukongMp.Sdk\WukongMp.Sdk.csproj"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

    <ItemGroup Label="SDK DLLs" Condition="'$(UseSdkProjectReferences)' == 'false'">
        <Analyzer Include="$(SdkDllPath)\ReadyM.Api.Generators.dll"/>
        <Reference Include="WukongMp.Api">
            <HintPath>$(SdkDllPath)\WukongMp.Api.dll</HintPath>
        </Reference>
        <Reference Include="WukongMp.Sdk">
            <HintPath>$(SdkDllPath)\WukongMp.Sdk.dll</HintPath>
        </Reference>
        <Reference Include="ReadyM.Api">
            <HintPath>$(SdkDllPath)\ReadyM.Api.dll</HintPath>
        </Reference>
        <Reference Include="ReadyM.Api.Multiplayer">
            <HintPath>$(SdkDllPath)\ReadyM.Api.Multiplayer.dll</HintPath>
        </Reference>
        <Reference Include="ReadyM.Relay.Client">
            <HintPath>$(SdkDllPath)\ReadyM.Relay.Client.dll</HintPath>
        </Reference>
        <Reference Include="ReadyM.Wukong.Common">
            <HintPath>$(SdkDllPath)\ReadyM.Wukong.Common.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Third-party game and core DLLs. Paths overridable via Directory.Build.props. -->

    <ItemGroup Label="Mod loader DLLs">
        <Reference Include="0Harmony">
            <HintPath>$(LoaderDllPath)\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBase">
            <HintPath>$(LoaderDllPath)\CSharpModBase.dll</HintPath>
        </Reference>
        <Reference Include="CSharpModBaseV2">
            <HintPath>$(LoaderDllPath)\CSharpModBaseV2.dll</HintPath>
        </Reference>
        <Reference Include="PreludeLib">
            <HintPath>$(LoaderDllPath)\PreludeLib.dll</HintPath>
        </Reference>
        <Reference Include="LiteNetLib" Condition="'$(UseSdkProjectReferences)' == 'false'">
            <HintPath>$(LoaderDllPath)\LiteNetLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8"/>
    </ItemGroup>


    <ItemGroup>
        <!-- Reference-only assemblies for the game. Compile-time only, the real
             assemblies are already loaded in the game process at runtime. -->
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831-preview.1" />
    </ItemGroup>
</Project>