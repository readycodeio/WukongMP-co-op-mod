<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WukongMp.Coop.Common\WukongMp.Coop.Common.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <UseSdkProjectReferences Condition="'$(UseSdkProjectReferences)' == ''">false</UseSdkProjectReferences>
        <!-- Where the SDK sources live when building in source mode. An uberrepo overrides
             these; the defaults assume the repositories sit side by side. -->
        <WukongSdkRoot Condition="'$(WukongSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\wukongmp-sdk</WukongSdkRoot>
        <CoreSdkRoot Condition="'$(CoreSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\readym-core-sdk</CoreSdkRoot>
        <!-- server mods run on net10.0, so they use the ServerSDK builds, not the netstandard2.0 ones -->
    </PropertyGroup>

    <ItemGroup Condition="'$(UseSdkProjectReferences)' == 'true'">
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="$(CoreSdkRoot)\src\ReadyM.Relay.Server.Sdk\ReadyM.Relay.Server.Sdk.csproj" />
        <ProjectReference Include="$(WukongSdkRoot)\ReadyM.Wukong.Common\ReadyM.Wukong.Common.csproj" />
    </ItemGroup>

    <!-- Standalone clones build against the prebuilt net10.0 SDK in Dependencies/ServerSDK instead. -->
    <ItemGroup Condition="'$(UseSdkProjectReferences)' == 'false'">
        <PackageReference Include="ReadyM.SDK.Wukong.Server" Version="0.4.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8"/>
    </ItemGroup>

</Project>
